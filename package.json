{
  "name": "pushie",
  "displayName": "pushie",
  "description": "Meet pushie, the virtual pet living in your repositories. Keep him alive by pushing code, watch him evolve with your PRs, and get roasted by his AI for messy commit messages. ",
  "version": "0.0.1",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/maiscommentz/pushie.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pushie-explorer",
          "title": "pushie",
          "icon": "media/pushie-activity.svg"
        }
      ]
    },
    "views": {
      "pushie-explorer": [
        {
          "type": "webview",
          "id": "pushie.dashboard",
          "name": "dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "pushie.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "pushie",
      "properties": {
        "pushie.aiProvider": {
          "type": "string",
          "enum": [
            "OpenAI",
            "Groq"
          ],
          "default": "OpenAI",
          "description": "Select your AI Provider."
        },
        "pushie.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for your selected AI Provider."
        },
        "pushie.apiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "The model to use. E.g., 'gpt-4o-mini' for OpenAI, 'llama3-8b-8192' for Groq, or 'local-model' for LM Studio."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "octokit": "^5.0.5"
  }
}